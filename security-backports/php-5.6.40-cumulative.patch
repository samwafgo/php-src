+/*
+ * GHSA-w8hw-w9fx-j79w (CVE-2026-109618) backport from PHP-7.4 security branch.
+ *
+ * On OOM the engine state may be inconsistent; performing a bailout
+ * (longjmp) from the memory manager corrupts global state which can be
+ * abused for remote code execution. Instead, print the error directly to
+ * stderr (without allocating) and terminate the process immediately.
+ * Under PHP-FPM / mod_php the master respawns a clean worker.
+ */
+ZEND_API void zend_mm_safe_error_ex(const char *format, ...)
+{
+	const char *error_filename;
+	uint error_lineno;
+	char buf[1024];
+	va_list args;
+
+	TSRMLS_FETCH();
+	if (zend_is_compiling(TSRMLS_C)) {
+		error_filename = zend_get_compiled_filename(TSRMLS_C);
+		error_lineno = zend_get_compiled_lineno(TSRMLS_C);
+	} else if (EG(in_execution)) {
+		error_filename = EG(active_op_array)?EG(active_op_array)->filename:NULL;
+		error_lineno = EG(opline_ptr)?(*EG(opline_ptr))->lineno:0;
+	} else {
+		error_filename = NULL;
+		error_lineno = 0;
+	}
+	if (!error_filename) {
+		error_filename = "Unknown";
+	}
+
+	va_start(args, format);
+	vsnprintf(buf, sizeof(buf), format, args);
+	va_end(args);
+
+	fprintf(stderr, "\nFatal error: %s in %s on line %d\n", buf, error_filename, error_lineno);
+/* See http://support.microsoft.com/kb/190351 */
+#ifdef PHP_WIN32
+	fflush(stderr);
+#endif
+	/* Never bailout: terminate the worker to guarantee clean state. */
+	_exit(1);
+}
